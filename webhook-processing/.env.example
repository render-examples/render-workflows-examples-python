# Both services
DATABASE_URL=postgresql://localhost:5432/webhook_processing

# Receiver (web service)
# The webhook's secret. Use the same value in GitHub's webhook settings.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-webhook-secret
RENDER_API_KEY=your-render-api-key
WORKFLOW_SLUG=webhook-processing
# For local development against `render workflows dev`:
# RENDER_USE_LOCAL_DEV=true
